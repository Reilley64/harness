{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "../..",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**/*.ts", "src/**/*.tsx", "*.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "overrides": [
    {
      "includes": [
        "src/components/atoms/terminal-text.tsx",
        "src/hooks/use-model-picker.ts",
        "src/services/terminal-scroll.ts",
        "src/services/transcript.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "domains": {
      "react": "recommended",
      "project": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  }
}
